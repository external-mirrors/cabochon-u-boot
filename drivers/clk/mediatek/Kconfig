if ARCH_MEDIATEK || ARCH_COREBOOT

config CLK_MTK
	bool
	depends on CLK && DM_RESET && POWER_DOMAIN
	def_bool n

menu "MediaTek clock drivers"

config CLK_MTK_MT7622
	bool "MediaTek MT7622 Clock Controller"
	select CLK_MTK
	default y if CONFIG_TARGET_MT7622
	help
	Say Y here to enable support for the clock controller
	on the MediaTek MT7622 SoC.

config CLK_MTK_MT7623
	bool "MediaTek MT7623 Clock Controller"
	select CLK_MTK
	default y if CONFIG_TARGET_MT7623
